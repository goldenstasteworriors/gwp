{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-gigaai.local/schemas/wam-sim-oracle-scenario-manifest-v1.json",
  "title": "WAM asymmetric bimanual pouring simulation scenario manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_spec_sha256",
    "generation",
    "status",
    "variant_ids",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "wam-sim-oracle-scenario-manifest/v1"
    },
    "benchmark_id": {
      "const": "g1-asym25-bimanual-pour-oracle-v0"
    },
    "benchmark_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "generator_sha256",
        "generator_seed",
        "method"
      ],
      "properties": {
        "generator": {
          "type": "string"
        },
        "generator_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generator_seed": {
          "type": "integer"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "spec_only_no_go",
        "execution_ready"
      ]
    },
    "variant_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "execution_binding": {
      "type": [
        "object",
        "null"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "condition_id",
        "split",
        "replicate_index",
        "seeds",
        "factors",
        "ood_axis",
        "embodiment",
        "ground_truth_contract_id"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^simb-(sanity|id-test|ood-test)-c[0-9]{3}-r[0-9]{2}$"
        },
        "condition_id": {
          "type": "string",
          "pattern": "^simb-(sanity|id-test|ood-test)-c[0-9]{3}$"
        },
        "split": {
          "enum": [
            "sanity",
            "id_test",
            "ood_test"
          ]
        },
        "replicate_index": {
          "type": "integer",
          "minimum": 0
        },
        "seeds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "physics",
            "render",
            "policy"
          ],
          "properties": {
            "physics": {
              "type": "integer",
              "minimum": 0
            },
            "render": {
              "type": "integer",
              "minimum": 0
            },
            "policy": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "factors": {
          "type": "object"
        },
        "ood_axis": {
          "type": [
            "string",
            "null"
          ]
        },
        "embodiment": {
          "type": "object"
        },
        "ground_truth_contract_id": {
          "const": "native-state-no-edit/v1"
        }
      }
    }
  }
}
