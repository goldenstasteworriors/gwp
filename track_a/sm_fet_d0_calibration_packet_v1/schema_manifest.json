{
  "manifest_schema_version": "sm_fet_d0_csv_schema_manifest_v1_fix2",
  "packet_schema_version": "sm_fet_d0_calibration_packet_v1_fix2",
  "frame_clock": "raw_video_frame_30fps",
  "csv_dialect": {
    "encoding": "utf-8",
    "delimiter": ",",
    "quotechar": "\"",
    "lineterminator": "LF",
    "bom_allowed": false
  },
  "role_contract": {
    "authority": "minimal-r1d frozen human shared semantic JSON plus D0 annotation handbook",
    "human_shared_semantic_schema_id": "sm_fet_r1d_shared_semantic_key_v1",
    "canonical_role_enum": [
      "MANIPULATED_OR_SOURCE",
      "TOOL",
      "RECEPTACLE_OR_DESTINATION",
      "FIXTURE_OR_SUPPORT"
    ],
    "ordinal_to_role": {
      "1": "MANIPULATED_OR_SOURCE",
      "2": "TOOL",
      "3": "RECEPTACLE_OR_DESTINATION",
      "4": "FIXTURE_OR_SUPPORT"
    },
    "node_slot_to_role": {
      "0": "MANIPULATED_OR_SOURCE",
      "1": "TOOL",
      "2": "RECEPTACLE_OR_DESTINATION",
      "3": "FIXTURE_OR_SUPPORT"
    },
    "worksheet_value_enums": {
      "events_v1.csv.focus_role": "canonical_role_enum",
      "event_node_snapshots_v1.csv.node_role": "canonical_role_enum",
      "event_node_snapshots_v1.csv.node_slot": "node_slot_to_role key",
      "event_edges_v1.csv.primary_role": "canonical_role_enum",
      "event_edges_v1.csv.secondary_role": "NONE or canonical_role_enum",
      "segments.csv.object_role": "canonical_role_enum"
    },
    "forbidden_legacy_role_tokens": [
      "TOOL_OR_MEDIATOR",
      "SUPPORT_OR_CONTEXT"
    ]
  },
  "csv_files": {
    "task_manifest.csv": {
      "kind": "immutable_manifest",
      "header": "schema_version,task_id,dataset_id,episode_id,media_id,frame_clock,coverage_start_frame,coverage_end_frame,required_review,calibration_only,formal_blind_overlap",
      "header_sha256": "187c27d002ff38334b6109dbe5c0a0e6b3df6fff3509f505f1841ab9e0765773",
      "assignment_file_sha256": "22de1250aef781ff6c09bc340f55af9c288e4330cf784a5ec1bc885a241a4706"
    },
    "media_allowlist.csv": {
      "kind": "immutable_manifest",
      "header": "schema_version,task_id,media_id,media_filename,video_bytes,video_sha256,video_frames,video_duration_s,video_fps,video_width,video_height,video_codec,hash_status",
      "header_sha256": "74920532b77c101abe82622005b6e0f33c72f6a69bea3699642cab4f14e59c5a",
      "assignment_file_sha256": "bcb9dd81e8a4800717c037ec1866a2d1ce3f76d7aca75bb3b9750c5ead1c3486"
    },
    "coverage.csv": {
      "kind": "mutable_annotation",
      "primary_key": "coverage_id",
      "header": "schema_version,dataset_id,episode_id,coverage_id,annotation_role,annotator_id,annotation_session_id,review_status,coverage_mode,start_frame,end_frame,frame_clock,evidence_scope,label_origin,review_timestamp_utc,parent_coverage_ids,notes",
      "header_sha256": "e6bd9eb229102a8999971286be463c338952214e6c3022f8225ce9ab7a3eb9c8",
      "blank_file_sha256": "e6bd9eb229102a8999971286be463c338952214e6c3022f8225ce9ab7a3eb9c8"
    },
    "segments.csv": {
      "kind": "mutable_annotation",
      "primary_key": "segment_id",
      "foreign_keys": ["coverage_id", "onset_event_id", "release_event_id"],
      "header": "schema_version,dataset_id,episode_id,coverage_id,segment_id,onset_event_id,release_event_id,annotation_role,annotator_id,annotation_session_id,review_status,start_frame,end_frame,start_boundary,end_boundary,side,site,object_role,contact_mode,confidence,evidence_scope,label_origin,source_proposal_id,parent_segment_ids,notes",
      "header_sha256": "d3b900c4a607a1afb87e77e2f491e453f7abb5acffa90663ea39b6283cda31ee",
      "blank_file_sha256": "d3b900c4a607a1afb87e77e2f491e453f7abb5acffa90663ea39b6283cda31ee"
    },
    "events_v1.csv": {
      "kind": "mutable_annotation",
      "primary_key": "event_id",
      "foreign_keys": ["coverage_id"],
      "header": "schema_version,dataset_id,episode_id,coverage_id,event_id,event_order,task_family,task_ontology_version,event_kind,focus_role,focus_entity_id,support_start_frame,support_end_frame,start_frame_lo,start_frame_hi,start_boundary,end_frame_lo,end_frame_hi,end_boundary,object_effect,outcome,event_kind_review_state,effect_review_state,outcome_review_state,confidence,evidence_scope,evidence_tier,active_hand,active_hand_review_state,annotation_role,annotator_id,annotation_session_id,review_status,label_origin,parent_event_ids,notes",
      "header_sha256": "b6bb7ad2526cf0119072dae7465c7cb8e686b6bb26cedb3015b3ad3a27130e8d",
      "blank_file_sha256": "b6bb7ad2526cf0119072dae7465c7cb8e686b6bb26cedb3015b3ad3a27130e8d"
    },
    "event_node_snapshots_v1.csv": {
      "kind": "mutable_annotation",
      "foreign_keys": ["event_id"],
      "header": "schema_version,dataset_id,episode_id,event_id,snapshot_role,frame_index,node_slot,node_role,entity_id,binding_provenance,observability,center_cell,scale_band,orientation_2d,observability_review_state,center_review_state,scale_review_state,orientation_review_state,evidence_scope,evidence_tier,annotation_role,annotator_id,annotation_session_id,review_status,label_origin,parent_snapshot_ids",
      "header_sha256": "4026cdc8a83a2c0a04f39260dbd403d120140a3bb62757a2a71ce27f012ab1ad",
      "blank_file_sha256": "4026cdc8a83a2c0a04f39260dbd403d120140a3bb62757a2a71ce27f012ab1ad"
    },
    "event_edges_v1.csv": {
      "kind": "mutable_annotation",
      "primary_key": "edge_id",
      "foreign_keys": ["event_id", "contact_segment_id"],
      "header": "schema_version,dataset_id,episode_id,edge_id,event_id,edge_order,effector_side,primary_role,primary_entity_id,primary_part,primary_surface_cell,secondary_present,secondary_role,contact_segment_id,contact_mode,relation_before,relation_after,primary_part_review_state,primary_cell_review_state,contact_mode_review_state,relation_before_review_state,relation_after_review_state,confidence,evidence_scope,evidence_tier,annotation_role,annotator_id,annotation_session_id,review_status,label_origin,parent_edge_ids",
      "header_sha256": "b5af024dcc7305fc946a9b48a35bc795472e477a2ecf286130804472d7382993",
      "blank_file_sha256": "b5af024dcc7305fc946a9b48a35bc795472e477a2ecf286130804472d7382993"
    },
    "pose_keys_2d_v1.csv": {
      "kind": "mutable_annotation",
      "primary_key": "pose_key_id",
      "foreign_keys": ["event_id"],
      "header": "schema_version,dataset_id,episode_id,pose_key_id,event_id,pose_role,frame_index,hand_side,reference_entity_id,box_x0_norm,box_y0_norm,box_x1_norm,box_y1_norm,wrist_x_norm,wrist_y_norm,wrist_visibility,palm_center_x_norm,palm_center_y_norm,palm_center_visibility,thumb_tip_x_norm,thumb_tip_y_norm,thumb_tip_visibility,index_tip_x_norm,index_tip_y_norm,index_tip_visibility,middle_tip_x_norm,middle_tip_y_norm,middle_tip_visibility,ring_tip_x_norm,ring_tip_y_norm,ring_tip_visibility,little_tip_x_norm,little_tip_y_norm,little_tip_visibility,aperture_band,grasp_family,palm_axis_bin,confidence,evidence_scope,annotation_role,annotator_id,annotation_session_id,review_status,label_origin,parent_pose_key_ids",
      "header_sha256": "85d138ee6d946f0035253dc839a5a1ae1af33e4bc2b4f806486a46c1b2ff583c",
      "blank_file_sha256": "85d138ee6d946f0035253dc839a5a1ae1af33e4bc2b4f806486a46c1b2ff583c"
    }
  },
  "reference_contract": {
    "events_v1.csv.coverage_id": "required; references coverage.csv.coverage_id in the same episode",
    "segments.csv.coverage_id": "required; references coverage.csv.coverage_id in the same episode",
    "segments.csv.onset_event_id": "optional; when non-empty references events_v1.csv.event_id in the same episode",
    "segments.csv.release_event_id": "optional; when non-empty references events_v1.csv.event_id in the same episode",
    "event_edges_v1.csv.contact_segment_id": "optional; when non-empty references segments.csv.segment_id in the same episode",
    "event_node_snapshots_v1.csv.event_id": "required; references events_v1.csv.event_id in the same episode",
    "event_edges_v1.csv.event_id": "required; references events_v1.csv.event_id in the same episode",
    "pose_keys_2d_v1.csv.event_id": "required when a pose row is present; references events_v1.csv.event_id in the same episode"
  },
  "submission_contract": {
    "required_coverage": "exactly one submitted EXHAUSTIVE full-episode row for each of the three assigned episodes",
    "no_event_present": "allowed: a submitted EXHAUSTIVE coverage row may have zero rows for its episode in events, segments, nodes, edges, and pose",
    "optional_tables": [
      "segments.csv",
      "events_v1.csv",
      "event_node_snapshots_v1.csv",
      "event_edges_v1.csv",
      "pose_keys_2d_v1.csv"
    ],
    "row_terminal_status": "submitted",
    "nonterminal_statuses_rejected": ["draft", "in_progress", "assigned_not_started"]
  }
}
